{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notify-cron",
      "schedule": "30 6 * * 4"
    },
    {
      "path": "/api/notify-cron-last",
      "schedule": "30 9 * * 4"
    }
  ]
}
